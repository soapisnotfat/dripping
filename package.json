{
  "name": "dripping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first MusicXML practice and recording studio",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@soundtouchjs/core": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "opensheetmusicdisplay": "2.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
